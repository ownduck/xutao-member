{
  "name": "member",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm run dev -w web\" \"npm run dev -w server\"",
    "build": "npm run build -w web && npm run build -w server && node scripts/copy-web-dist.mjs",
    "start": "npm run start:prod -w server",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:push": "npm run db:push -w server",
    "db:seed": "npm run db:seed -w server",
    "test:e2e": "npm run test:e2e -w web",
    "test:e2e:api": "npm run test:e2e -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
